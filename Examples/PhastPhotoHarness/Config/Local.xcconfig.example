// Copy to Local.xcconfig (git-ignored) and fill in. Use a throwaway bundle ID: a Personal Team that signs an
// identifier keeps it, and it can never move to a paid team.

DEVELOPMENT_TEAM = ABCDE12345
HARNESS_BUNDLE_ID = com.yourname.phastphoto-harness
// Only for the "PhastPhotoHarness USB" scheme, which needs a paid team. You can reuse an App ID that already has
// the DriverKit capability, such as the USB test host's from Drivers/PhastPhotoUSBDriver.
// HARNESS_USB_BUNDLE_ID = com.yourcompany.phastphoto.USBHost
