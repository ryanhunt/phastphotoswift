<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Documents (the log and raw scans) in Files > On My iPad. The generated Info.plist drops this key when
	     it is set as INFOPLIST_KEY_UIFileSharingEnabled, so it lives here; the rest is generated and merged. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
