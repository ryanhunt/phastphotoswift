// The app's connection to PhastPhotoUSBDriver: selectors in PhastPhotoUSBProtocol.h.

#ifndef PhastPhotoUSBUserClient_h
#define PhastPhotoUSBUserClient_h

#include <Availability.h>
#include <DriverKit/IOUserClient.iig>

class PhastPhotoUSBUserClient : public IOUserClient
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual kern_return_t ExternalMethod(uint64_t selector, IOUserClientMethodArguments *arguments,
                                         const IOUserClientMethodDispatch *dispatch, OSObject *target,
                                         void *reference) override;
};

#endif
